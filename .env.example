# Copy this file to .env and fill in your values
# docker-compose.yml reads .env from the project root automatically

DATABASE_URL=postgresql://meduser:medpass@postgres:5432/meddb

# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_use_random_32_bytes_in_production

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
